  "firestore": {
    "/patrol_reports/{reportId}": {
      "schema": "PatrolReport",
      "description": "Koleksi data patroli harian unit Wildlife Hazard"
    },
    "/occurrence_reports/{reportId}": {
      "schema": "OccurrenceReport",
      "description": "Koleksi insiden perjumpaan satwa liar di airside"
    },
    "/strike_reports/{reportId}": {
      "schema": "WildlifeStrikeReport",
      "description": "Koleksi insiden wildlife strike pesawat udara"
    },
    "/vehicle_reports/{reportId}": {
      "schema": "VehicleCheckReport",
      "description": "Koleksi laporan pengecekan kendaraan operasional serah terima dinas"
    },
    "/management_recipients/{recipientId}": {
      "schema": "ManagementRecipient",
      "description": "Koleksi kontak pejabat dan pemangku kepentingan untuk broadcast"
    },
    "/notification_logs/{logId}": {
      "schema": "NotificationLog",
      "description": "Koleksi riwayat broadcast dan transmisi laporan"
    },
    "/monthly_report_documents/{docId}": {
      "schema": "MonthlyReportDocument",
      "description": "Koleksi arsip berkas laporan bulanan terdahulu dalam format PDF, Word, dan Excel"
    },
    "/duty_roster_documents/{docId}": {
      "schema": "DutyRosterDocument",
      "description": "Koleksi berkas roster jadwal dinas operasional resmi dalam format Excel dan PDF"
    },
    "/monthly_wsr_manual/{docId}": {
      "schema": "ManualMonthlyWSRDoc",
      "description": "Koleksi data manual input kejadian WSR bulanan tersinkronisasi real-time"
    }
