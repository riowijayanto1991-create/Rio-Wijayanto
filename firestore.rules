rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Laporan Patroli Harian
    match /patrol_reports/{reportId} {
      allow read: if true;
      allow create, update: if isValidId(reportId)
        && request.resource.data.reportNumber is string
        && request.resource.data.reportNumber.size() > 0
        && request.resource.data.reportNumber.size() <= 64;
      allow delete: if isValidId(reportId);
    }

    // Laporan Occurrence Satwa
    match /occurrence_reports/{reportId} {
      allow read: if true;
      allow create, update: if isValidId(reportId)
        && request.resource.data.reportNumber is string
        && request.resource.data.reportNumber.size() > 0
        && request.resource.data.reportNumber.size() <= 64;
      allow delete: if isValidId(reportId);
    }

    // Laporan Wildlife Strike
    match /strike_reports/{reportId} {
      allow read: if true;
      allow create, update: if isValidId(reportId)
        && request.resource.data.reportNumber is string
        && request.resource.data.reportNumber.size() > 0
        && request.resource.data.reportNumber.size() <= 64;
      allow delete: if isValidId(reportId);
    }

    // Laporan Pengecekan Kendaraan Operasional (Serah Terima Tugas Dinas Pagi & Malam)
    match /vehicle_reports/{reportId} {
      allow read: if true;
      allow create, update: if isValidId(reportId)
        && request.resource.data.reportNumber is string
        && request.resource.data.reportNumber.size() > 0
        && request.resource.data.reportNumber.size() <= 64;
      allow delete: if isValidId(reportId);
    }

    // Daftar Pejabat / Kontak Broadcast
    match /management_recipients/{recipientId} {
      allow read: if true;
      allow create, update: if isValidId(recipientId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if false;
    }

    // Log Notifikasi Broadcast
    match /notification_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId)
        && request.resource.data.reportNumber is string;
      allow update, delete: if false;
    }

    // Dokumen Laporan Bulanan Terdahulu (PDF / Word / Excel)
    match /monthly_report_documents/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow delete: if isValidId(docId);
    }

    // Dokumen Roster Dinas (Excel / PDF)
    match /duty_roster_documents/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow delete: if isValidId(docId);
    }

    // Pengaturan Sistem & Susunan Personel Roster (Real-time Sync Antar Device)
    match /whms_settings/{settingId} {
      allow read, write: if true;
    }

    // Pengisian Manual Kejadian WSR Per Bulan (Real-time Sync Antar Device)
    match /monthly_wsr_manual/{docId} {
      allow read, write: if true;
    }
  }
}
